                script.onload = function() {
                    loadScript(index + 1);
                };
                document.body.appendChild(script);
            }
            
            loadScript(0);
        });

        // Płynne przewijanie dla linków kotwic
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
